<%- include('../partials/admin-head') %>

<div class="section-head">
  <span class="muted"><%= products.length %> products</span>
  <a class="btn btn-primary" href="/admin/products/new">+ Add product</a>
</div>

<div class="card">
  <table class="table">
    <thead><tr><th></th><th>Name</th><th>Category</th><th>Price</th><th>Stock</th><th>Flags</th><th></th></tr></thead>
    <tbody>
      <% products.forEach(function(p){ %>
        <tr>
          <td><img class="table-thumb" src="<%= p.image %>" alt=""></td>
          <td><strong><%= p.name %></strong><br><span class="muted small"><%= p.brand %></span></td>
          <td><%= p.category %></td>
          <td><%= money(p.price) %></td>
          <td><span class="stock-dot <%= p.stock === 0 ? 'out' : (p.stock <= 10 ? 'low' : 'ok') %>"></span><%= p.stock %></td>
          <td>
            <% if (p.featured) { %><span class="mini-tag">Featured</span><% } %>
            <% if (p.deal) { %><span class="mini-tag deal">Deal</span><% } %>
          </td>
          <td class="row-actions">
            <a class="link" href="/admin/products/<%= p.id %>/edit">Edit</a>
            <form action="/admin/products/<%= p.id %>/delete" method="post" onsubmit="return confirm('Delete <%= p.name.replace(/'/g, '') %>?')">
              <button class="link danger" type="submit">Delete</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<%- include('../partials/admin-foot') %>
