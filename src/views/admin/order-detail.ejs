<%- include('../partials/admin-head') %>

<div class="admin-cols">
  <section class="card">
    <h3>Items</h3>
    <% order.items.forEach(function(it){ %>
      <div class="summary-item">
        <img src="<%= it.image %>" alt="">
        <span class="summary-item-name"><%= it.name %> <span class="muted">x <%= it.qty %></span></span>
        <span><%= money(it.price * it.qty) %></span>
      </div>
    <% }) %>
    <div class="summary-row"><span>Subtotal</span><span><%= money(order.subtotal) %></span></div>
    <div class="summary-row"><span>Delivery</span><span><%= order.delivery === 0 ? 'FREE' : money(order.delivery) %></span></div>
    <div class="summary-row total"><span>Total</span><span><%= money(order.total) %></span></div>

    <h3>Customer</h3>
    <p>
      <strong><%= order.customer.name %></strong><br>
      <%= order.customer.email || '' %><br>
      <%= order.customer.phone %><br>
      <%= order.customer.address %>, <%= order.customer.city %> - <%= order.customer.pincode %>
    </p>
    <p class="muted">Payment: <%= order.payment %></p>
  </section>

  <section class="card">
    <h3>Status</h3>
    <form action="/admin/orders/<%= order.id %>/status" method="post" class="form-grid">
      <div class="field span-2">
        <select name="status">
          <% orderStatuses.forEach(function(s){ %>
            <option value="<%= s %>" <%= order.status === s ? 'selected' : '' %>><%= s %></option>
          <% }) %>
        </select>
      </div>
      <button class="btn btn-primary span-2" type="submit">Update status</button>
    </form>
    <h3>History</h3>
    <ul class="history-list">
      <% order.history.slice().reverse().forEach(function(h){ %>
        <li><strong><%= h.status %></strong> <span class="muted"><%= new Date(h.at).toLocaleString('en-IN') %></span></li>
      <% }) %>
    </ul>
  </section>
</div>

<%- include('../partials/admin-foot') %>
