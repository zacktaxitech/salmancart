<%- include('../partials/head') %>
<%- include('../partials/header') %>

<div class="container">
  <div class="section-head"><h2>My Cart <% if (count > 0) { %><span class="muted">(<%= count %> item<%= count === 1 ? '' : 's' %>)</span><% } %></h2></div>

  <% if (items.length === 0) { %>
    <div class="card empty-state">
      <h3>Your cart is empty</h3>
      <p class="muted">Add something you love and it will show up here.</p>
      <a class="btn btn-primary" href="/products">Start shopping</a>
    </div>
  <% } else { %>
    <div class="cart-layout">
      <div class="cart-items">
        <% items.forEach(function(it){ %>
          <div class="cart-item card">
            <a class="cart-thumb" href="/product/<%= it.product.slug %>" style="--accent:<%= it.product.color || '#4f46e5' %>">
              <img src="<%= it.product.image %>" alt="<%= it.product.name %>">
            </a>
            <div class="cart-info">
              <a class="product-name" href="/product/<%= it.product.slug %>"><%= it.product.name %></a>
              <div class="price-row">
                <span class="price"><%= money(it.product.price) %></span>
                <% if (it.product.mrp > it.product.price) { %><span class="mrp"><%= money(it.product.mrp) %></span><% } %>
              </div>
              <div class="cart-controls">
                <form action="/cart/update" method="post" class="qty-form">
                  <input type="hidden" name="productId" value="<%= it.product.id %>">
                  <div class="qty-stepper">
                    <button type="submit" name="qty" value="<%= it.qty - 1 %>">-</button>
                    <input type="text" value="<%= it.qty %>" readonly aria-label="Quantity">
                    <button type="submit" name="qty" value="<%= it.qty + 1 %>">+</button>
                  </div>
                </form>
                <form action="/cart/remove" method="post">
                  <input type="hidden" name="productId" value="<%= it.product.id %>">
                  <button class="link danger" type="submit">Remove</button>
                </form>
              </div>
            </div>
            <div class="cart-line"><%= money(it.line) %></div>
          </div>
        <% }) %>
      </div>
      <aside class="card summary-card">
        <h3>Price details</h3>
        <div class="summary-row"><span>Price (<%= count %> item<%= count === 1 ? '' : 's' %>)</span><span><%= money(mrpTotal) %></span></div>
        <div class="summary-row"><span>Discount</span><span class="save-tag">- <%= money(discount) %></span></div>
        <div class="summary-row"><span>Delivery</span><span><%= delivery === 0 ? 'FREE' : money(delivery) %></span></div>
        <div class="summary-row total"><span>Total</span><span><%= money(subtotal + delivery) %></span></div>
        <a class="btn btn-primary btn-lg btn-block" href="/checkout">Place order</a>
        <p class="muted small">Cash on Delivery. Free delivery over Rs. 499.</p>
      </aside>
    </div>
  <% } %>
</div>

<%- include('../partials/footer') %>
