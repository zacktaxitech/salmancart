<%- include('../partials/head') %>
<%- include('../partials/header') %>

<div class="container">
  <div class="section-head"><h2>Checkout</h2></div>
  <% if (error) { %><div class="toast toast-warn static"><%= error %></div><% } %>
  <div class="cart-layout">
    <div class="card checkout-card">
      <h3>Delivery address</h3>
      <form action="/checkout" method="post" class="form-grid">
        <div class="field"><label>Full name</label><input name="name" required value="<%= user ? user.name : '' %>"></div>
        <div class="field"><label>Phone</label><input name="phone" required placeholder="10-digit mobile number"></div>
        <div class="field span-2"><label>Address</label><textarea name="address" rows="3" required placeholder="House no, street, area"></textarea></div>
        <div class="field"><label>City</label><input name="city" required></div>
        <div class="field"><label>PIN code</label><input name="pincode" required pattern="[0-9]{6}" placeholder="6-digit PIN"></div>
        <div class="span-2">
          <h3>Payment</h3>
          <label class="payment-option">
            <input type="radio" name="payment" value="cod" checked>
            <span><strong>Cash on Delivery</strong><br><span class="muted">Pay when your order arrives.</span></span>
          </label>
          <button class="btn btn-primary btn-lg" type="submit">Place order - <%= money(subtotal + delivery) %></button>
        </div>
      </form>
    </div>
    <aside class="card summary-card">
      <h3>Order summary</h3>
      <% items.forEach(function(it){ %>
        <div class="summary-item">
          <img src="<%= it.product.image %>" alt="">
          <span class="summary-item-name"><%= it.product.name %> <span class="muted">x <%= it.qty %></span></span>
          <span><%= money(it.line) %></span>
        </div>
      <% }) %>
      <div class="summary-row"><span>Subtotal</span><span><%= money(subtotal) %></span></div>
      <div class="summary-row"><span>You save</span><span class="save-tag">- <%= money(discount) %></span></div>
      <div class="summary-row"><span>Delivery</span><span><%= delivery === 0 ? 'FREE' : money(delivery) %></span></div>
      <div class="summary-row total"><span>Total</span><span><%= money(subtotal + delivery) %></span></div>
    </aside>
  </div>
</div>

<%- include('../partials/footer') %>
