<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= title %> | SalmanCart Admin</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/app.css">
<link rel="icon" href="/images/logo.svg" type="image/svg+xml">
</head>
<body class="admin-body">
<div class="admin-shell">
  <aside class="admin-side">
    <a class="brand admin-brand" href="/admin">
      <img src="/images/logo.svg" alt="" class="brand-mark">
      <span class="brand-name">Salman<em>Cart</em></span>
    </a>
    <nav class="admin-nav">
      <a href="/admin" class="<%= title.includes('Dashboard') ? 'active' : '' %>">Dashboard</a>
      <a href="/admin/products" class="<%= title.includes('Product') || title === 'Products' ? 'active' : '' %>">Products</a>
      <a href="/admin/categories" class="<%= title.includes('Categor') ? 'active' : '' %>">Categories</a>
      <a href="/admin/orders" class="<%= title.includes('Order') ? 'active' : '' %>">Orders</a>
      <a href="/admin/inventory" class="<%= title.includes('Inventory') ? 'active' : '' %>">Inventory</a>
      <a href="/admin/users" class="<%= title.includes('Users') ? 'active' : '' %>">Users</a>
    </nav>
    <div class="admin-side-foot">
      <a href="/" class="link">View storefront</a>
      <a href="/logout" class="link danger">Logout</a>
    </div>
  </aside>
  <main class="admin-main">
    <div class="admin-topbar">
      <h1><%= title %></h1>
      <span class="muted"><%= adminUser.name %> · admin</span>
    </div>
